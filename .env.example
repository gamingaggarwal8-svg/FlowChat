# Copy to .env.local. Never commit real values. Offline demo needs none of these.
GEMINI_API_KEY=
# Verified Flash free-tier model; quotas/availability depend on your AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: webhooks, scheduled sync and verified billing. NEVER use NEXT_PUBLIC here.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
CRON_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional existing monthly INR plan IDs matching 49900 / 99900 paise.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Legacy evaluator only; new chat imports use Gemini.
ANTHROPIC_API_KEY=
