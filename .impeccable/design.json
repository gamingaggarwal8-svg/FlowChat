      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace navigation\"><button class=\"ds-nav-item ds-focus\" aria-current=\"page\">Inventory &amp; growth</button><button class=\"ds-nav-item ds-focus\">Suppliers</button></nav>",
      "css": ".ds-nav{font-family:\"Public Sans\",system-ui,sans-serif;background:var(--nav);padding:18px;width:236px}.ds-nav-item{font-family:\"Public Sans\",system-ui,sans-serif;display:flex;align-items:center;width:100%;min-height:43px;margin-bottom:3px;padding:10px 13px;border:0;border-radius:7px;background:none;text-align:left;font-size:13px;color:#d0dcee;cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-nav-item:hover{background:#233c5d;color:white}.ds-nav-item[aria-current=page]{background:var(--blue);color:white}.ds-focus:focus-visible{outline:3px solid var(--focus,#688af3);outline-offset:4px;border-radius:4px}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition-duration:0s}}"
    },
    {
      "name": "Quantity Status",
      "kind": "chip",
      "refersTo": "status",
      "description": "Static text labels with semantic colour; no invented hover state.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-status ds-low\">Low</span><span class=\"ds-status ds-adequate\">Adequate</span><span class=\"ds-status ds-critical\">Critical</span></div>",
      "css": ".ds-tags{display:flex;gap:8px;flex-wrap:wrap}.ds-status{font-family:\"Public Sans\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:4px;white-space:nowrap;padding:5px 8px;border-radius:5px;font-size:10px;line-height:1.5;font-weight:500}.ds-low{background:var(--amber-soft);color:#865d1d}.ds-adequate{background:#e8f4ed;color:#246b49}.ds-critical{background:var(--red-soft);color:#9b4646}"
    },
    {
      "name": "Working Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Shared flat container for operations and charts.",
      "html": "<section class=\"ds-panel\"><h2>Inventory planning sheet</h2><p>Review stock cover and incoming orders before committing.</p></section>",
      "css": ".ds-panel{font-family:\"Public Sans\",system-ui,sans-serif;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius);padding:24px;min-width:0}.ds-panel h2{margin:0;font-size:18px;line-height:1.4;letter-spacing:-.015em;font-weight:650}.ds-panel p{margin:6px 0 0;font-size:12px;line-height:1.7;color:var(--muted);max-width:72ch}@media(max-width:760px){.ds-panel{padding:20px 16px;border-radius:12px}}"
    },
    {
      "name": "Evidence Table",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Source-grounded row and header styles with horizontal overflow.",
      "html": "<div class=\"ds-table-wrap\"><table class=\"ds-table\"><thead><tr><th scope=\"col\">PRODUCT</th><th scope=\"col\">ON HAND</th><th scope=\"col\">INCOMING</th></tr></thead><tbody><tr><td>P01 · Sample product</td><td>120 mtr</td><td>600 mtr</td></tr></tbody></table></div>",
      "css": ".ds-table-wrap{overflow-x:auto;overscroll-behavior-x:contain}.ds-table{font-family:\"Public Sans\",system-ui,sans-serif;border-collapse:collapse;width:100%;text-align:left;white-space:nowrap;font-size:12px;font-variant-numeric:tabular-nums}.ds-table th{font-weight:550;font-size:11px;line-height:1.4;letter-spacing:.015em;padding:13px 12px;color:#5f7190;background:#f6f8fc;border-bottom:1px solid var(--line)}.ds-table td{padding:17px 12px;border-bottom:1px solid var(--line-soft);color:#33465f}.ds-table tr:last-child td{border-bottom:0}.ds-table tbody tr:hover{background:#f8faff}"
    },
    {
      "name": "Stock Position",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Illustrative preview of separate on-hand, incoming and target encodings.",
      "html": "<div class=\"ds-stock\"><div class=\"ds-stock-labels\"><span>On hand <strong>120 mtr</strong></span><span>Incoming <strong>600 mtr</strong></span><span>Target <strong>600 mtr</strong></span></div><div class=\"ds-track\" role=\"img\" aria-label=\"Illustration: 120 metres on hand, 600 incoming, target 600\"><span class=\"ds-hand\" style=\"width:15%\"></span><span class=\"ds-inbound\" style=\"width:75%\"></span><span class=\"ds-target\" style=\"left:75%\"></span></div></div>",
      "css": ".ds-stock{font-family:\"Public Sans\",system-ui,sans-serif;font-size:12px;color:#4d635a}.ds-stock-labels{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.ds-stock-labels strong{color:#273e37;font-weight:650;font-variant-numeric:tabular-nums}.ds-track{display:flex;height:16px;background:#eef1f6;margin-top:13px;position:relative;border-radius:4px}.ds-hand{background:#c78332;border-radius:4px 0 0 4px}.ds-inbound{background:#b7c9fa;border-radius:0 4px 4px 0}.ds-target{position:absolute;height:26px;width:1px;background:#324d77;top:-5px}"
    }
  ],
  "narrative": {
    "northStar": "Production-label clarity",
    "overview": "Production-label clarity gives FlowChat a professional, colourful working interface for a busy textile distributor. Public Sans, an ink-blue navigation rail, a cool off-white work area and crisp white sheets carry the system. Colour identifies customer, supplier and stock contexts while numbers, source evidence and next actions supply the emphasis.\n\nThe material is flat and precise: thin borders, tonal insets, modest corners and tabular figures. The source implements responsive grids, labelled controls, visible focus styles and reduced-motion overrides. This record describes implemented source, not rendered approval: current desktop/mobile captures are absent, and rendered contrast, keyboard interaction and microphone operation remain unverified.",
    "keyCharacteristics": [
      "One sans family with tabular business figures.",
      "Ink-blue shell with white working sheets.",
      "Cobalt customer, violet supplier and emerald stock context.",
      "Evidence links and explicit status text alongside colour.",
      "Border-led depth and brief state transitions."
    ],
    "rules": [
      {
        "name": "The Context Colour Rule",
        "body": "Keep customer, supplier and inventory colour assignments consistent; pair commitment and risk colours with explicit state text.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use tabular figures for money, table cells and operational metrics; retain Indian-format currency labels.",
        "section": "typography"
      },
      {
        "name": "The Border-Led Depth Rule",
        "body": "Use thin dividers and tonal insets to separate working regions. Resting panels do not carry box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Public Sans and the established headline, body and supporting hierarchy.",
      "Do retain labelled controls, visible focus treatments and reduced-motion overrides.",
      "Do keep on-hand, incoming and target quantities separately labelled in stock diagrams.",
      "Do use horizontally scrolling table wrappers and source evidence actions for dense records."
    ],
    "donts": [
      "Don't replace semantic status text with colour alone.",
      "Don't add resting panel shadows to this flat working system.",
      "Don't promote a one-off accent, caption or uppercase metadata treatment into a global display style.",
      "Don't describe current screenshots, contrast, keyboard flows or microphone operation as verified without rendered evidence."
    ]
  }
